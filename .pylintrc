[MAIN]
# gcpy/_version.py is auto-generated by setup.py at build/install time.
ignore=_version.py

[MESSAGES CONTROL]
disable=
    line-too-long,
    too-many-lines,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-public-methods,
    too-many-instance-attributes,
    too-few-public-methods,
    wildcard-import,
    unused-wildcard-import,

[BASIC]
# Common short scientific/plotting variable names used throughout gcpy
# (grids, datasets, axes, loop indices), plus AP/BP hybrid-grid coefficient
# names (gcpy/grid.py) that mirror standard GEOS-Chem terminology.
good-names=i,j,k,l,m,n,x,y,z,ax,df,ds,da,fig,nx,ny,nz,nt,lat,lon,lats,lons,dt,e,f,AP,BP,_

# AP/BP are GEOS-Chem's standard names for hybrid-grid coefficients, also
# used in compound forms like AP_edge/BP_edge/AP_mid/BP_mid (gcpy/grid.py).
good-names-rgxs=^(AP|BP)(_[a-z]+)?$

# Private helpers (leading underscore) are not required to have docstrings;
# public functions/classes still are.
no-docstring-rgx=^_

# Allow lowercase snake_case module-level names (e.g. `parser`, `args` in
# CLI scripts' `if __name__ == "__main__":` blocks), not just UPPER_CASE.
const-rgx=([A-Za-z_][A-Za-z0-9_]*)$
